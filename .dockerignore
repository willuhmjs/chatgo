# Build context hygiene — the Dockerfile only needs go.mod/go.sum, cmd/,
# internal/, web/. Everything else is excluded.
.git
.gitignore
.github
.dockerignore
LICENSE
README.md
SECURITY.md
CONTRIBUTING.md
docs/
deploy/
bench/
Makefile

# Never send local state or build outputs into the daemon
node_modules/
web/node_modules/
web/dist/
internal/web/dist/
bin/
data/
*.db
*.db-*
.env
.DS_Store
